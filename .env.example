# GateMaster AI - Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Frontend Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Edge Function Server-Side Secrets (Set via: supabase secrets set KEY=VALUE)
# The Edge Function `solve-problem` uses ONE of the following server-side keys:
GEMINI_API_KEY=your-google-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
